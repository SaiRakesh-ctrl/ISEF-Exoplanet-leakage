 improves F1 by {f1_diff*100:.2f}%\")\n    print(\"\\n  RECOMMENDATION: Remove SMOTE from your main pipeline\")\n    print(\"\\n  Why SMOTE hurts:\")\n    print(\"    - Your dataset has 6,930 unique stars with 7,201 samples\")\n    print(\"    - Most classes are already well-represented\")\n    print(\"    - SMOTE creates synthetic samples that may not reflect real stellar physics\")\n    print(\"    - The class imbalance is natural and shouldn't be artificially corrected\")\nelse:\n    print(\"\\n  SMOTE is helping performance\")\n    print(f\"  Accuracy improvement: {abs(acc_diff)*100:.2f}%\")\n\n# Save results\nresults = {\n    'Condition': ['Without SMOTE', 'With SMOTE'],\n    'Accuracy': [acc_no_smote, acc_with_smote],\n    'F1_Weighted': [f1_no_smote, f1_with_smote]\n}\nresults_df = pd.DataFrame(results)\nresults_df.to_csv('enhanced_analysis_outputs/smite_impact_results.csv', index=False)\nprint(f\"\\n✓ Saved to: enhanced_analysis_outputs/smite_impact_results.csv\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"HOW TO REPORT AT ISEF\")\nprint(\"=\"*80)\nprint(\"\"\"\nSay at ISEF:\n  \"We tested SMOTE oversampling and found it reduced accuracy by X%, so we removed it.\"\n  \"This shows we critically evaluated each component of our pipeline.\"\n  \"Our final model uses star-grouped validation without artificial oversampling.\"\n\nThis demonstrates:\n  ✓ You understand your pipeline\n  ✓ You test assumptions (not just follow tutorials)\n  ✓ You optimize based on evidence, not convention\n\"\"\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-17T15:49:24.238081Z","iopub.execute_input":"2026-10-17T15:49:24.23846Z","iopub.status.idle":"2026-10-17T15:49:28.033502Z","shell.execute_reply.started":"2026-10-17T15:49:24.238436Z","shell.execute_reply":"2026-10-17T15:49:28.032824Z"}},"outputs":[{"name":"stdout","text":"================================================================================\nSMOTE IMPACT ANALYSIS\n=====================================