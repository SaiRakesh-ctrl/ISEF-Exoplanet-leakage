============================================\n\ndef load_and_preprocess_data(csv_path='/kaggle/input/datasets/mithunmeenakshis/tess-exoplanet-dataset/TESS exoplanet data.csv'):\n    \"\"\"Load and preprocess TESS data (same as your notebook).\"\"\"\n    print(\"Loading data...\")\n    df = pd.read_csv(csv_path)\n    print(f\"  Raw data: {df.shape[0]} rows, {df.shape[1]} columns\")\n\n    # Clean\n    from sklearn.impute import SimpleImputer\n    df_clean = df.dropna(subset=['tfopwg_disp']).copy()\n    imputer = SimpleImputer(strategy='median')\n    feature_cols = df_clean.select_dtypes(include=['float64', 'int64']).columns\n    df_clean[feature_cols] = imputer.fit_transform(df_clean[feature_cols])\n    df = df_clean.copy()\n\n    # Feature selection\n    top_features = ['st_tmag', 'pl_eqt', 'pl_tranmid', 'pl_insol', 'st_rad',\n                    'st_teff', 'st_logg', 'pl_rade', 'pl_trandurh', 'pl_orbper']\n    X = df[top_features].values\n    y = df['tfopwg_disp'].values\n    star_ids = df['tid'].values\n\n    # Encode labels\n    label_encoder = LabelEncoder()\n    y_encoded = label_encoder.fit_transform(y)\n\n    print(f\"  Cleaned: {len(df)} samples, {len(np.unique(star_ids))} unique stars\")\n    print(f\"  Features: {len(top_features)}\")\n    print(f\"  Classes: {len(np.unique(y_encoded))}\")\n\n    return X, y, y_encoded, star_ids, label_encoder, top_features, df\n\n\n# ============================================================================\n# ANALYSIS 1: QUANTITATIVE LEAKAGE REPRODUCTION (HEADLINE RESULT)\n# ============================================================================\n\ndef quantitative_leakage_reproduction(X, y_encoded, star_ids):\n    \"\"\"\n    HEADLINE ANALYSIS: Quantitatively demonstrate data leakage across multiple models.\n\n    This is your #1 most important result. It shows:\n    - Exactly how much random splits inflate accuracy\n    - That this is a systematic problem, not just one model\n    - Concrete numbers judges can verify\n    \"\"\"\n    print(\"\\n\" + \"=\"*80)\n    print(\"ANALYSIS 1: QUANTITATIVE LEAKAGE REPRODUCTION\")\n    print(\"=\"*80)\n\n    # Define models to test\n    models = {\n        'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42),\n        'Random Forest': RandomForestClassifier(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1),\n        'XGBoost-like': GradientBoostingClassifier(n_estimators=100, max_depth=7, learning_rate=0.1, random_state=42),\n        'SVM': SVC(kernel='rbf', C=10, gamma='scale', random_state=42, probability=True)\n    }\n\n    results = []\n\n    for model_name, model_template in models.items():\n        print(f\"\\n{model_name}:\")\n\n        # Scale features (needed for LR and SVM)\n        scaler = StandardScaler()\n        X_scaled = scaler.fit_transform(X)\n\n        # SPLIT A: Random split (LEAKED)\n        X_train_r, X_test_r, y_train_r, y_test_r, stars_train_r, stars_test_r = train_test_split(\n            X_scaled, y_encoded, star_ids, test_size=0.30, random_state=42, stratify=y_encoded\n        )\n\n        # Check star overlap\n        star_overlap_r = len(set(stars_train_r) & set(stars_test_r))\n\n        # Train and evaluate\n        model_r = model_template.__class__(**model_template.get_params())\n        model_r.fit(X_train_r, y_train_r)\n        y_pred_r = model_r.predict(X_test_r)\n        acc_random = accuracy_score(y_test_r, y_pred_r)\n\n        # SPLIT B: Star-grouped split (HONEST)\n        gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=42)\n        train_idx, test_idx = next(gss.split(X_scaled, y_encoded, groups=star_ids))\n        X_train_g, X_test_g = X_scaled[train_idx], X_scaled[test_idx]\n        y_train_g, y_test_g = y_encoded[train_idx], y_encoded[test_idx]\n        stars_train_g, stars_test_g = star_ids[train_idx], star_ids[test_idx]\n\n        # Check star overlap (should be 0)\n        star_overlap_g = len(set(stars_train_g) & set(stars_test_g))\n\n        # Train and evaluate\n        model_g = model_template.__class__(**model_template.get_params())\n        model_g.fit(X_train_g, y_train_g)\n        y_pred_g = model_g.predict(X_test_g)\n        acc_grouped = accuracy_score(y_test_g, y_pred_g)\n\n        # Calculate inflation\n        abs_inflation = acc_random - acc_grouped\n        rel_inflation = (abs_inflation / acc_grouped) * 100 if acc_grouped > 0 else 0\n\n        print(f\"  Random split:   {acc_random:.4f} ({acc_random*100:.2f}%) [star overlap: {star_overlap_r}]\")\n        print(f\"  Grouped split:  {acc_grouped:.4f} ({acc_grouped*100:.2f}%) [star overlap: {star_overlap_g}]\")\n        print(f\"  Inflation:      {abs_inflation:.4f} ({rel_inflation:.1f}%)\")\n\n        results.append({\n            'Model': model_name,\n            'Random_Split_Acc': acc_random,\n            'Grouped_Split_Acc': acc_grouped,\n            'Absolute_Inflation': abs_inflation,\n            'Relative_Inflation_Pct': rel_inflation,\n            'Star_Overlap_Random': star_overlap_r,\n            'Star_Overlap_Grouped': star_overlap_g\n        })\n\n    # Create summary DataFrame\n    results_df = pd.DataFrame(results)\n\n    # Calculate average inflation\n    avg_abs_inflation = results_df['Absolute_Inflation'].mean()\n    avg_rel_inflation = results_df['Relative_Inflation_Pct'].mean()\n\n    print(\"\\n\" + \"-\"*80)\n    print(\"SUMMARY:\")\n    print(f\"  Average absolute inflation: {avg_abs_inflation:.4f} ({avg_abs_inflation*100:.2f}%)\")\n    print(f\"  Average relative inflation: {avg_rel_inflation:.1f}%\")\n    print(f\"  Range: {results_df['Relative_Inflation_Pct'].min():.1f}% - {results_df['Relative_Inflation_Pct'].max():.1f}%\")\n\n    # Save results\n    results_df.to_csv(OUTPUT_DIR / 'quantitative_leakage_results.csv', index=False)\n    print(f\"\\n✓ Saved to: {OUTPUT_DIR / 'quantitative_leakage_results.csv'}\")\n\n    # Create visualization\n    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n    # Plot 1: Accuracy comparison\n    x = np.arange(len(results_df))\n    width = 0.35\n    axes[0].bar(x - width/2, results_df['Random_Split_Acc'], width, label='Random Split (Leaked)', color='#e74c3c', alpha=0.8)\n    axes[0].bar(x + width/2, results_df['Grouped_Split_Acc'], width, label='Star-Grouped (Honest)', color='#2ecc71', alpha=0.8)\n    axes[0].set_xlabel('Model', fontsize=12, fontweight='bold')\n    axes[0].set_ylabel('Test Accuracy', fontsize=12, fontweight='bold')\n    axes[0].set_title('Data Leakage Inflates Accuracy', fontsize=14, fontweight='bold')\n    axes[0].set_xticks(x)\n    axes[0].set_xticklabels(results_df['Model'], rotation=15, ha='right')\n    axes[0].legend()\n    axes[0].grid(axis='y', alpha=0.3)\n    axes[0].set_ylim([0, 1])\n\n    # Plot 2: Inflation percentages\n    colors = ['#e74c3c' if x > avg_rel_inflation else '#f39c12' for x in results_df['Relative_Inflation_Pct']]\n    axes[1].bar(results_df['Model'], results_df['Relative_Inflation_Pct'], color=colors, alpha=0.8)\n    axes[1].axhline(avg_rel_inflation, color='black', linestyle='--', linewidth=2, label=f'Average: {avg_rel_inflation:.1f}%')\n    axes[1].set_xlabel('Model', fontsize=12, fontweight='bold')\n    axes[1].set_ylabel('Accuracy Inflation (%)', fontsize=12, fontweight='bold')\n    axes[1].set_title('How Much Random Splits Inflate Accuracy', fontsize=14, fontweight='bold')\n    axes[1].tick_params(axis='x', rotation=15)\n    axes[1].legend()\n    axes[1].grid(axis='y', alpha=0.3)\n\n    plt.tight_layout()\n    plt.savefig(OUTPUT_DIR / 'quantitative_leakage_visualization.png', dpi=300, bbox_inches='tight')\n    print(f\"✓ Saved visualization to: {OUTPUT_DIR / 'quantitative_leakage_visualization.png'}\")\n\n    # Return results for use in other analyses\n    return results_df\n\n\n# ============================================================================\n# ANALYSIS 2: ABLATION STUDY\n# ============================================================================\n\ndef ablation_study(X, y_encoded, star_ids, df):\n    \"\"\"\n    Show what each component of your pipeline contributes.\n\n    This answers: \"Is the CNN actually better, or is it just the star-grouping?\"\n    \"\"\"\n    print(\"\\n\" + \"=\"*80)\n    print(\"ANALYSIS 2: ABLATION STUDY\")\n    print(\"=\"*80)\n\n    results = []\n\n    # Condition 1: Random split + Simple model (baseline)\n    print(\"\\nCondition 1: Random Split + Logistic Regression\")\n    scaler = StandardScaler()\n    X_scaled = scaler.fit_transform(X)\n    X_train, X_test, y_train, y_test = train_test_split(\n        X_scaled, y_encoded, test_size=0.30, random_state=42, stratify=y_encoded\n    )\n    model = LogisticRegression(max_iter=1000, random_state=42)\n    model.fit(X_train, y_train)\n    y_pred = model.predict(X_test)\n    acc = accuracy_score(y_test, y_pred)\n    f1 = f1_score(y_test, y_pred, average='weighted')\n    results.append({'Condition': 'Random Split + Logistic Regression', 'Accuracy': acc, 'F1_Weighted': f1})\n    print(f\"  Accuracy: {acc:.4f}, F1: {f1:.4f}\")\n\n    # Condition 2: Grouped split + Simple model (isolation: grouping effect)\n    print(\"\\nCondition 2: Star-Grouped Split + Logistic Regression\")\n    gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=42)\n    train_idx, test_idx = next(gss.split(X_scaled, y_encoded, groups=star_ids))\n    X_train_g, X_test_g = X_scaled[train_idx], X_scaled[test_idx]\n    y_train_g, y_test_g = y_encoded[train_idx], y_encoded[test_idx]\n    model = LogisticRegression(max_iter=1000, random_state=42)\n    model.fit(X_train_g, y_train_g)\n    y_pred = model.predict(X_test_g)\n    acc = accuracy_score(y_test_g, y_pred)\n    f1 = f1_score(y_test_g, y_pred, average='weighted')\n    results.append({'Condition': 'Grouped Split + Logistic Regression', 'Accuracy': acc, 'F1_Weighted': f1})\n    print(f\"  Accuracy: {acc:.4f}, F1: {f1:.4f}\")\n\n    # Condition 3: Grouped split + Random Forest (isolation: model complexity)\n    print(\"\\nCondition 3: Star-Grouped Split + Random Forest\")\n    model = RandomForestClassifier(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1)\n    model.fit(X_train_g, y_train_g)\n    y_pred = model.predict(X_test_g)\n    acc = accuracy_score(y_test_g, y_pred)\n    f1 = f1_score(y_test_g, y_pred, average='weighted')\n    results.append({'Condition': 'Grouped Split + Random Forest', 'Accuracy': acc, 'F1_Weighted': f1})\n    print(f\"  Accuracy: {acc:.4f}, F1: {f1:.4f}\")\n\n    # Condition 4: Grouped split + SMOTE + Random Forest (isolation: SMOTE effect)\n    print(\"\\nCondition 4: Star-Grouped Split + SMOTE + Random Forest\")\n    smote = SMOTE(random_state=42, k_neighbors=5)\n    X_train_res, y_train_res = smote.fit_resample(X_train_g, y_train_g)\n    model = RandomForestClassifier(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1)\n    model.fit(X_train_res, y_train_res)\n    y_pred = model.predict(X_test_g)\n    acc = accuracy_score(y_test_g, y_pred)\n    f1 = f1_score(y_test_g, y_pred, average='weighted')\n    results.append({'Condition': 'Grouped + SMOTE + Random Forest', 'Accuracy': acc, 'F1_Weighted': f1})\n    print(f\"  Accuracy: {acc:.4f}, F1: {f1:.4f}\")\n\n    # Condition 5: Grouped split + CNN (your full pipeline, simplified version)\n    # Note: For this ablation, we'll use a simpler CNN or skip if TensorFlow not available\n    print(\"\\nCondition 5: Star-Grouped Split + CNN (simplified)\")\n    try:\n        import tensorflow as tf\n        from tensorflow.keras import layers, models\n\n        # Build a simple CNN (not residual, just for comparison)\n        model_cnn = models.Sequential([\n            layers.Dense(64, activation='relu', input_shape=(X_train_g.shape[1],)),\n            layers.Dense(64, activation='relu'),\n            layers.Dense(32, activation='relu'),\n            layers.Dense(len(np.unique(y_encoded)), activation='softmax')\n        ])\n        model_cnn.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])\n\n        # Apply SMOTE\n        smote = SMOTE(random_state=42, k_neighbors=5)\n        X_train_res, y_train_res = smote.fit_resample(X_train_g, y_train_g)\n\n        # Train\n        history = model_cnn.fit(X_train_res, y_train_res, epochs=50, batch_size=32,\n                               validation_split=0.15, verbose=0)\n\n        # Evaluate\n        y_pred_proba = model_cnn.predict(X_test_g, verbose=0)\n        y_pred = np.argmax(y_pred_proba, axis=1)\n        acc = accuracy_score(y_test_g, y_pred)\n        f1 = f1_score(y_test_g, y_pred, average='weighted')\n        results.append({'Condition': 'Grouped + SMOTE + CNN', 'Accuracy': acc, 'F1_Weighted': f1})\n        print(f\"  Accuracy: {acc:.4f}, F1: {f1:.4f}\")\n    except ImportError:\n        print(\"  TensorFlow not available, skipping CNN condition\")\n        results.append({'Condition': 'Grouped + SMOTE + CNN', 'Accuracy': np.nan, 'F1_Weighted': np.nan})\n\n    # Create summary DataFrame\n    results_df = pd.DataFrame(results)\n\n    # Calculate marginal contributions\n    print(\"\\n\" + \"-\"*80)\n    print(\"MARGINAL CONTRIBUTIONS:\")\n    baseline_acc = results_df.iloc[0]['Accuracy']\n    for i, row in results_df.iterrows():\n        if i > 0 and not np.isnan(row['Accuracy']):\n            delta = row['Accuracy'] - results_df.iloc[i-1]['Accuracy']\n            print(f\"  {row['Condition']}: Δ = {delta:+.4f} ({delta*100:+.2f}%)\")\n\n    # Save results\n    results_df.to_csv(OUTPUT_DIR / 'ablation_study_results.csv', index=False)\n    print(f\"\\n✓ Saved to: {OUTPUT_DIR / 'ablation_study_results.csv'}\")\n\n    # Visualization\n    fig, ax = plt.subplots(figsize=(10, 6))\n    bars = ax.barh(results_df['Condition'], results_df['Accuracy'], color='steelblue', alpha=0.8)\n    ax.set_xlabel('Test Accuracy', fontsize=12, fontweight='bold')\n    ax.set_title('Ablation Study: What Each Component Contributes', fontsize=14, fontweight='bold')\n    ax.grid(axis='x', alpha=0.3)\n    ax.set_xlim([0, 1])\n\n    # Add value labels\n    for bar, acc in zip(bars, results_df['Accuracy']):\n        if not np.isnan(acc):\n            ax.text(bar.get_width() + 0.02, bar.get_y() + bar.get_height()/2,\n                   f'{acc:.3f}', va='center', fontsize=10)\n\n    plt.tight_layout()\n    plt.savefig(OUTPUT_DIR / 'ablation_study_visualization.png', dpi=300, bbox_inches='tight')\n    print(f\"✓ Saved visualization to: {OUTPUT_DIR / 'ablation_study_visualization.png'}\")\n\n    return results_df\n\n\n# ============================================================================\n# ANALYSIS 3: CALIBRATION ANALYSIS\n# ============================================================================\n\ndef calibration_analysis(X, y_encoded, star_ids):\n    \"\"\"\n    Show that your model's confidence scores are well-calibrated.\n\n    This answers: \"When the model says 80% confident, is it actually right 80% of the time?\"\n    \"\"\"\n    print(\"\\n\" + \"=\"*80)\n    print(\"ANALYSIS 3: CALIBRATION ANALYSIS\")\n    print(\"=\"*80)\n\n    # Prepare data\n    scaler = StandardScaler()\n    X_scaled = scaler.fit_transform(X)\n\n    # Star-grouped split\n    gss = GroupShuffleSplit(n_splits=1, test_size=0.30, random_state=42)\n    train_idx, test_idx = next(gss.split(X_scaled, y_encoded, groups=star_ids))\n    X_train, X_test = X_scaled[train_idx], X_scaled[test_idx]\n    y_train, y_test = y_encoded[train_idx], y_encoded[test_idx]\n\n    # Apply SMOTE\n    smote = SMOTE(random_state=42, k_neighbors=5)\n    X_train_res, y_train_res = smote.fit_resample(X_train, y_train)\n\n    # Train a model with probability outputs\n    print(\"\\nTraining Random Forest for calibration analysis...\")\n    model = RandomForestClassifier(n_estimators=100, max_depth=15, random_state=42, n_jobs=-1)\n    model.fit(X_train_res, y_train_res)\n\n    # Get probability predictions\n    y_pred_proba = model.predict_proba(X_test)\n    y_pred_confidence = np.max(y_pred_proba, axis=1)\n    y_pred_class = np.argmax(y_pred_proba, axis=1)\n    y_correct = (y_pred_class == y_test).astype(int)\n\n    # Calibration curve\n    print(\"\\nComputing calibration curve...\")\n    prob_true, prob_pred = calibration_curve(y_correct, y_pred_confidence, n_bins=10, strategy='uniform')\n\n    # Expected Calibration Error (ECE)\n    ece = 0\n    total_samples = len(y_correct)\n    for i in range(len(prob_pred)):\n        bin_size = np.sum((y_pred_confidence >= i/10) & (y_pred_confidence < (i+1)/10))\n        ece += (bin_size / total_samples) * abs(prob_true[i] - prob_pred[i])\n\n    print(f\"  Expected Calibration Error (ECE): {ece:.4f}\")\n    print(f\"  (Lower is better. Perfect calibration = 0.0)\")\n\n    # Decision curve analysis\n    print(\"\\nComputing decision curves...\")\n    thresholds = np.arange(0.5, 1.0, 0.05)\n    decision_results = []\n\n    for thresh in thresholds:\n        high_conf_mask = y_pred_confidence >= thresh\n        if np.sum(high_conf_mask) == 0:\n            continue\n\n        n_selected = np.sum(high_conf_mask)\n        n_correct = np.sum(y_correct[high_conf_mask])\n        precision = n_correct / n_selected\n        recall = n_correct / np.sum(y_correct)\n\n        # Net benefit = (true positives / N) - (false positives / N) * (threshold / (1 - threshold))\n        # Simplified: precision - (1 - precision) * (thresh / (1 - thresh))\n        net_benefit = precision - (1 - precision) * (thresh / (1 - thresh))\n\n        decision_results.append({\n            'Threshold': thresh,\n            'N_Selected': n_selected,\n            'Precision': precision,\n            'Recall': recall,\n            'Net_Benefit': net_benefit\n        })\n\n    decision_df = pd.DataFrame(decision_results)\n\n    print(\"\\nDecision Curve Results:\")\n    print(decision_df.to_string(index=False))\n\n    # Save results\n    decision_df.to_csv(OUTPUT_DIR / 'calibration_decision_curves.csv', index=False)\n    print(f\"\\n✓ Saved to: {OUTPUT_DIR / 'calibration_decision_curves.csv'}\")\n\n    # Visualization\n    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n\n    # Plot 1: Calibration curve\n    axes[0].plot(prob_pred, prob_true, 'o-', label='Model', color='steelblue', linewidth=2, markersize=8)\n    axes[0].plot([0, 1], [0, 1], 'k--', label='Perfect calibration', linewidth=2)\n    axes[0].set_xlabel('Mean Predicted Probability', fontsize=12, fontweight='bold')\n    axes[0].set_ylabel('Fraction of Positives', fontsize=12, fontweight='bold')\n    axes[0].set_title(f'Calibration Curve (ECE = {ece:.4f})', fontsize=14, fontweight='bold')\n    axes[0].legend()\n    axes[0].grid(alpha=0.3)\n    axes[0].set_xlim([0, 1])\n    axes[0].set_ylim([0, 1])\n\n    # Plot 2: Decision curve\n    axes[1].plot(decision_df['Threshold'], decision_df['Net_Benefit'], 'o-',\n                label='Model', color='steelblue', linewidth=2, markersize=8)\n    axes[1].axhline(0, color='black', linestyle='--', linewidth=2, label='Treat all / none')\n    axes[1].set_xlabel('Confidence Threshold', fontsize=12, fontweight='bold')\n    axes[1].set_ylabel('Net Benefit', fontsize=12, fontweight='bold')\n    axes[1].set_title('Decision Curve Analysis', fontsize=14, fontweight='bold')\n    axes[1].legend()\n    axes[1].grid(alpha=0.3)\n\n    plt.tight_layout()\n    plt.savefig(OUTPUT_DIR / 'calibration_analysis_visualization.png', dpi=300, bbox_inches='tight')\n    print(f\"✓ Saved visualization to: {OUTPUT_DIR / 'calibration_analysis_visualization.png'}\")\n\n    return decision_df, ece\n\n\n# ============================================================================\n# ANALYSIS 4: EXPANDED AUDIT HELPER\n# ============================================================================\n\ndef expanded_audit_helper():\n    \"\"\"\n    Generate a structured literature review checklist for exoplanet ML papers.\n\n    This helps you systematically audit 25+ papers for your RNAAS submission.\n    \"\"\"\n    print(\"\\n\" + \"=\"*80)\n    print(\"ANALYSIS 4: EXPANDED 